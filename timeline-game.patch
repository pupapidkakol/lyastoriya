+  },
+  "events": [
+    {
+      "id": "baptism-rus",
+      "title": "Хрещення Русі",
+      "text": "Київський князь Володимир Святославич приймає християнство й охрещує киян. Нова віра стає офіційною для держави.",
+      "from": 988, "to": 989,
+      "dateLabel": "988 р. (за літописом; у науці також 988–989)",
+      "fact": "Традиційна дата — 988 рік за «Повістю врем’яних літ». В Encyclopedia of Ukraine вказано 988–989 роки, тож зараховуємо обидва. Християнізація була тривалим процесом: княгиня Ольга хрестилася ще раніше.",
+      "sources": [
+        { "type": "енциклопедія", "title": "Christianization of Ukraine — Encyclopedia of Ukraine", "url": "https://www.encyclopediaofukraine.com/pages/c/h/christianizationofukraine.htm" },
+        { "type": "стаття", "title": "Затилюк Я. Хрещення Русі князем Володимиром: конструювання історичної оповіді. Український історичний журнал, 2014, №1", "url": "https://nasu-periodicals.org.ua/index.php/uhj/article/download/29365/23456/46401" }
+      ]
+    },
+    {
+      "id": "ukraina-1187",
+      "title": "Перша літописна згадка слова «Україна»",
+      "text": "У літописі розповідається про смерть переяславського князя Володимира Глібовича. Поруч із цим з’являється слово, яке пізніше стане назвою нашої країни.",
+      "from": 1187, "to": 1187,
+      "dateLabel": "бл. 1187 р.",
+      "fact": "Це Київський літопис, що входить до Іпатіївського. Тоді «Україна» означала південні прикордонні землі Русі, а не всю сучасну державу.",
+      "sources": [
+        { "type": "енциклопедія", "title": "Kyiv Chronicle — Encyclopedia of Ukraine", "url": "https://www.encyclopediaofukraine.com/pages%5CK%5CY%5CKyivChronicle.htm" },
+        { "type": "Вікіпедія", "title": "Name of Ukraine — Wikipedia", "url": "https://en.wikipedia.org/wiki/Name_of_Ukraine" }
