+        { "type": "енциклопедія", "title": "Batu Khan — Encyclopedia of Ukraine", "url": "https://www.encyclopediaofukraine.com/pages%5CB%5CA%5CBatuKhan.htm" },
+        { "type": "стаття", "title": "Maiorov O. The Mongolian Capture of Kiev: The Two Dates", "url": "https://chtyvo.org.ua/authors/Maiorov_Oleksandr/The_Mongolian_Capture_of_Kiev_The_Two_Dates_anhl.pdf" },
